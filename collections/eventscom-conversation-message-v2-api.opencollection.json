          "info": {
            "name": "Get Messages By Conversation Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/ai/api/v2/conversations/:conversation_id/messages",
            "params": [
              {
                "name": "conversation_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "appId",
                "value": "",
                "type": "query",
                "description": "App ID"
              }
            ]
          },
          "docs": "Fetch messages by conversation ID. \nThe `thirdParty` query parameter is OPTIONAL (default is None).\nThe `appId` query parameter is OPTIONAL (default is None)."
        },
        {
