                "name": "conversation_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "message_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Message By Conid And Msgid"
        },
        {
          "info": {
            "name": "Delete Message By Conid And Msgid",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/ai/api/v2/conversations/:conversation_id/messages/:message_id",
