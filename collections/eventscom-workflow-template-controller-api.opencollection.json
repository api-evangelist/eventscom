            "name": "Get workflow template by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://datagol-be.events.com/orchestrator/api/v1/workflowTemplates/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Loads by id with active=true (soft-deleted templates are not returned). The template must belong to the logged-in user's company."
        },
        {
          "info": {
            "name": "Update workflow template",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://datagol-be.events.com/orchestrator/api/v1/workflowTemplates/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update workflow template"
        },
        {
          "info": {
            "name": "Soft-delete workflow template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://datagol-be.events.com/orchestrator/api/v1/workflowTemplates/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Soft-delete workflow template"
        },
        {
          "info": {
            "name": "Get workflow template by name",
            "type": "http"
